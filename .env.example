# Copy to .env.local and fill in. Never commit .env.local.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only (route handlers).
#
# Version 1 of the product (see docs/PRODUCT.md) needs NO keys: there is no backend
# for health data. The variables below belonged to the paused restroom map and menu
# reader. Keep them out of the client and do not add new ones without approval.

# PAUSED. Map tiles (public).
NEXT_PUBLIC_MAP_TILES_KEY=

# PAUSED. OpenRouteService (server-only).
OPENROUTESERVICE_API_KEY=

# PAUSED. Gemini API for the menu reader (server-only).
GEMINI_API_KEY=
