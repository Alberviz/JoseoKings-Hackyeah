# Copy to .env.local and fill in. Never commit .env.local.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only (route handlers).

# Map tiles (MapTiler / Stadia / Protomaps). Public: the browser loads tiles with it.
NEXT_PUBLIC_MAP_TILES_KEY=

# OpenRouteService: walking routes and isochrones. Server-only.
OPENROUTESERVICE_API_KEY=

# Gemini API: menu reader (vision). Server-only.
GEMINI_API_KEY=
